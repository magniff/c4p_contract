pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {ChessEngine} from "../src/ChessEngine.sol";
import {ChessEngineRef} from "./reference/ChessEngineRef.sol";
import {FenLib} from "./FenLib.sol";

/// The shipped engine is gas-optimised; `ChessEngineRef` is the straightforward version it replaced (frozen,
/// perft- and python-chess-verified). Everything observable must be identical: legality of every move encoding,
/// the resulting position, the legal-move list, the terminal outcome. A third oracle, python-chess, labels a corpus
/// of hard positions (mates, stalemates, single legal replies, en passant as the only escape, castling, promotion).
contract EngineEquivalenceTest is Test {
    function _ref(ChessEngine.Position memory p) internal pure returns (ChessEngineRef.Position memory) {
        return abi.decode(abi.encode(p), (ChessEngineRef.Position));
    }

    /// Terminal state and move generation agree with the reference.
    function _checkPosition(ChessEngine.Position memory p) internal pure {
        ChessEngineRef.Position memory r = _ref(p);
        bool has = ChessEngine.hasLegalMove(p);
        assertEq(has, ChessEngineRef.hasLegalMove(r), "hasLegalMove");
        assertEq(uint8(ChessEngine.outcome(p)), uint8(ChessEngineRef.outcome(r)), "outcome");
        uint16[] memory legal = ChessEngine.legalMoves(p);
        assertEq(has, legal.length > 0, "hasLegalMove vs exhaustive scan");
        assertEq(keccak256(abi.encode(legal)), keccak256(abi.encode(ChessEngineRef.legalMoves(r))), "legalMoves");
        assertEq(ChessEngine.positionKey(p), ChessEngineRef.positionKey(r), "positionKey");
        _checkAttacks(p.board);
    }

    /// Attack maps for both colours on every square, and the SWAR piece-presence test against a plain scan.
    function _checkAttacks(uint256 board) internal pure {
        for (uint8 sq; sq < 64; ++sq) {
            assertEq(ChessEngine.isAttacked(board, sq, true), ChessEngineRef.isAttacked(board, sq, true), "isAttacked b");
            assertEq(ChessEngine.isAttacked(board, sq, false), ChessEngineRef.isAttacked(board, sq, false), "isAttacked w");
        }
        for (uint8 piece; piece < 16; ++piece) {
            bool found;
            for (uint8 sq; sq < 64; ++sq) {
                if (ChessEngine.pieceAt(board, sq) == piece) found = true;
            }
            assertEq(ChessEngine.hasPiece(board, piece), found, "hasPiece");
        }
    }

    /// Raw 256-bit boards: every nibble value anywhere, including lanes the SWAR borrow logic is sensitive to.
    /// forge-config: deep.fuzz.runs = 4096
    function testFuzz_attacksOnRawBoards(uint256 board) public pure {
        _checkAttacks(board);
        _checkAttacks(board & 0x0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F0F);
        _checkAttacks(board & uint256(keccak256(abi.encode(board))));
    }

    /// One move encoding: same verdict, same resulting position, and isLegal agrees with applyMove.
    function _checkMove(ChessEngine.Position memory p, uint16 m) internal pure {
        (bool ok, ChessEngine.Position memory np) = ChessEngine.applyMove(p, m);
        (bool rok, ChessEngineRef.Position memory rnp) = ChessEngineRef.applyMove(_ref(p), m);
        assertEq(ok, rok, "applyMove verdict");
        assertEq(ok, ChessEngine.isLegal(p, m), "isLegal vs applyMove");
        assertEq(keccak256(abi.encode(np)), keccak256(abi.encode(rnp)), "applyMove result");
    }

    /// Every one of the 65536 move encodings (all from/to pairs, all 16 promotion nibbles) in a position.
    /// External so each position starts with fresh memory (Solidity never frees it within a call).
    function checkAllEncodings(ChessEngine.Position memory p) external pure {
        for (uint256 m; m < 65536; ++m) {
            _checkMove(p, uint16(m));
        }
    }

