    function test_onlyLegalMove_everyCandidateClass() public view {
        for (uint256 i; i < onlyMoveFens.length; ++i) {
            ChessEngine.Position memory p = FenLib.parse(onlyMoveFens[i]);
            string memory label = string.concat(onlyMoveClass[i], "  ", onlyMoveFens[i]);
            assertTrue(ChessEngine.hasLegalMove(p), label);
            ChessEngine.Outcome o = ChessEngine.outcome(p);
            assertTrue(o != ChessEngine.Outcome.Checkmate && o != ChessEngine.Outcome.Stalemate, label);
            uint16[] memory legal = ChessEngine.legalMoves(p);
            assertEq(legal.length, onlyMoveCount[i], label);
            uint16 want = FenLib.mv(onlyMoveUci[i]);
            for (uint256 j; j < legal.length; ++j) {
                assertEq(legal[j] & 0x0FFF, want, label); // same from/to (promotion piece aside)
            }
            _checkPosition(p);
        }
    }

