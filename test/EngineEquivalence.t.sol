    function test_corpus_matchesPythonChessAndReference() public view {
        for (uint256 i; i < corpus.length; ++i) {
            ChessEngine.Position memory p = FenLib.parse(corpus[i]);
            assertEq(ChessEngine.legalMoves(p).length, legalCount[i], corpus[i]);
            assertEq(ChessEngine.hasLegalMove(p), legalCount[i] > 0, corpus[i]);
            _checkPosition(p);
            uint16[] memory legal = ChessEngine.legalMoves(p);
            for (uint256 j; j < legal.length; ++j) {
                _checkMove(p, legal[j]);
                (, ChessEngine.Position memory np) = ChessEngine.applyMove(p, legal[j]);
                _checkPosition(np);
            }
        }
    }

    /// Exhaustive over the full move space in a handful of corpus positions of each kind.
    function test_corpus_allEncodings() public view {
        for (uint256 i; i < corpus.length; i += 31) {
            this.checkAllEncodings(FenLib.parse(corpus[i]));
        }
    }

