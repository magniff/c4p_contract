    function _perftFens() internal pure returns (string[6] memory) {
        return [
            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
            "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
            "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
            "r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1",
            "rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8",
            "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10"
        ];
    }

    /// Two plies deep from every perft position: every node and every legal move in it.
    function test_perftTrees_depth2() public view {
        string[6] memory fens = _perftFens();
        for (uint256 i; i < fens.length; ++i) {
            ChessEngine.Position memory p = FenLib.parse(fens[i]);
            this.checkAllEncodings(p);
            _checkPosition(p);
            uint16[] memory l1 = ChessEngine.legalMoves(p);
            for (uint256 a; a < l1.length; ++a) {
                _checkMove(p, l1[a]);
                (, ChessEngine.Position memory p1) = ChessEngine.applyMove(p, l1[a]);
                _checkPosition(p1);
                uint16[] memory l2 = ChessEngine.legalMoves(p1);
                for (uint256 b; b < l2.length; ++b) {
                    _checkMove(p1, l2[b]);
                }
            }
        }
    }

    // ------------------------------------------------------------------ fuzz

    /// Random games, checking every position plus a random (mostly illegal) encoding at each ply.
    /// Each run is ~200 positions x 128 reference attack maps; FOUNDRY_PROFILE=deep for the long soak.
    /// forge-config: default.fuzz.runs = 24
    /// forge-config: deep.fuzz.runs = 1024
    function testFuzz_randomGames(uint256 seed) public pure {
        ChessEngine.Position memory p = ChessEngine.initialPosition();
        for (uint256 ply; ply < 200; ++ply) {
            _checkPosition(p);
            uint256 rnd = uint256(keccak256(abi.encode(seed, ply)));
            _checkMove(p, uint16(rnd >> 32));
            uint16[] memory legal = ChessEngine.legalMoves(p);
            if (legal.length == 0) break;
            uint16 m = legal[rnd % legal.length];
            _checkMove(p, m);
            (, p) = ChessEngine.applyMove(p, m);
        }
    }

    /// Random boards: arbitrary piece soup (including pawns on back ranks, extra kings, many queens, random
    /// castling and en-passant fields). Not reachable in a game, which is the point: the candidate generator
    /// must still be a superset of the exhaustive scan everywhere.
    /// forge-config: deep.fuzz.runs = 4096
    function testFuzz_randomBoards(uint256 seed) public pure {
        uint256 rnd = uint256(keccak256(abi.encode(seed)));
        ChessEngine.Position memory p;
        uint256 board;
        uint256 n = 2 + rnd % 24;
        for (uint256 i; i < n; ++i) {
            uint256 r = uint256(keccak256(abi.encode(seed, i)));
            uint256 piece = 1 + r % 6 + (r >> 8) % 2 * 8;
            if (piece % 8 == 6) piece -= 1; // kings placed below, once each
            board |= piece << ((r >> 16) % 64 * 4);
        }
        uint8 wk = uint8(rnd >> 64) % 64;
        uint8 bk = uint8(rnd >> 72) % 64;
        if (bk == wk) bk = (wk + 9) % 64;
        board = (board & ~(uint256(0xF) << (wk * 4))) | (uint256(6) << (wk * 4));
        board = (board & ~(uint256(0xF) << (bk * 4))) | (uint256(14) << (bk * 4));
        p.board = board;
        p.whiteKing = wk;
        p.blackKing = bk;
        p.whiteToMove = (rnd >> 80) % 2 == 0;
        p.castling = uint8(rnd >> 88) % 16;
        p.epSquare = (rnd >> 96) % 3 == 0 ? uint8((rnd >> 104) % 64) : 0;
        p.halfmoveClock = uint8(rnd >> 112) % 110;
        p.fullmove = 1;
        _checkPosition(p);
        for (uint256 j; j < 32; ++j) {
            _checkMove(p, uint16(uint256(keccak256(abi.encode(seed, "m", j)))));
        }
        uint16[] memory legal = ChessEngine.legalMoves(p);
        for (uint256 j; j < legal.length; ++j) {
            _checkMove(p, legal[j]);
        }
    }
